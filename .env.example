# Copy to .env.local and fill in. Names only; never commit real values.

# Neon pooled connection string (runtime)
DATABASE_URL=
# Neon direct (unpooled) connection string (migrate/seed scripts; falls back to DATABASE_URL)
DATABASE_URL_UNPOOLED=
# Auth.js JWT signing secret (e.g. `openssl rand -base64 32`)
AUTH_SECRET=
# Canonical public URL of the app (also used for metadata)
AUTH_URL=
# GitHub OAuth app credentials (provider enabled only when both are set)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth credentials (provider enabled only when both are set)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email that is granted the admin role on sign-in
ADMIN_EMAIL=
# Bearer secret required by /api/refresh/cron (cron is rejected if unset)
CRON_SECRET=
# Boards refreshed per cron tick (default 4)
REFRESH_BOARDS_PER_TICK=
# Public API requests per key per hour (default 600)
API_RATE_LIMIT_PER_HOUR=
# Invalid/revoked API-key attempts per client IP per hour before 429 (default 30)
API_AUTH_FAIL_LIMIT_PER_HOUR=
# Remote Browserless websocket URL incl. token (enables browser adapters on Vercel)
BROWSERLESS_WS_URL=
# Set to 1 to disable browser-based adapters
JOBRADAR_DISABLE_BROWSER=
# Reed jobs API key (enables the Reed adapter)
REED_API_KEY=
# Base URL used in the bot User-Agent (/bot page); falls back to VERCEL_PROJECT_PRODUCTION_URL
APP_URL=
# Set to 1 in non-production to expose the test login provider
ENABLE_TEST_LOGIN=
# Set to 1 to log SQL in production (always on outside production)
JOBRADAR_LOG_SQL=
